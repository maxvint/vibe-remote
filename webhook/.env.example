# Server settings
PORT=3000
HOST=0.0.0.0

# GitHub webhook secret (from GitHub App settings)
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Trigger keywords (comma separated)
TRIGGER_KEYWORDS=@Codeholic,@Bot

# Redis connection
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=vibe:webhook:
EVENT_TTL=86400

# Push to vibe-remote
VIBE_REMOTE_URL=http://localhost:5124
PUSH_TOKEN=your_secret_token
